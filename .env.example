# Copie este archivo como .env y complete la clave. NO suba .env a GitHub.
ANTHROPIC_API_KEY=pegue_aqui_su_clave
# Modelo (se registra en cada corrida). Ejemplos: claude-sonnet-5-5, claude-haiku-5-5
CLAUDE_MODEL=claude-sonnet-5-5
TEMPERATURA=0.7
MAX_TOKENS=4096
# Rutas dentro de WSL/Linux (use el disco de Linux, no /mnt/c: es mucho más rápido)
D4J_HOME=/home/USUARIO/defects4j
D4J_TRABAJO=/home/USUARIO/d4j_trabajo
